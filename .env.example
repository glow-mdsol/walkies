# ==============================================================================
# Walkies — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root to configure the application:
# cp .env.example .env
#
# Note: For Docker deployment or local development, these variables are shared
# by both the backend FastAPI server and the frontend Vite/React client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google OAuth Authentication Configuration
# ------------------------------------------------------------------------------
# To allow users to authenticate securely, generate a Google OAuth 2.0 Client ID
# from the Google Cloud Console (https://console.cloud.google.com/).
# In production, ensure you add your deployment domains to the "Authorized 
# JavaScript Origins" and "Authorized Redirect URIs" lists.

# Google Client ID used by the FastAPI backend to verify incoming JWT ID tokens
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google Client ID used by the Vite React frontend for the login screen.
# (Vite injects variables prefixed with VITE_ directly into the client bundle).
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 2. Local Development Authentication Bypass
# ------------------------------------------------------------------------------
# Set to 1 to bypass the Google Login screen and authentication checks during 
# local offline development. When active, requests automatically authenticate 
# as a simulated developer user ('dev-user').
#
# WARNING: NEVER enable this bypass (set to 1) in production.
# Options: 0 (disabled/secure), 1 (enabled/dev-bypass)
WALKIES_DEV_BYPASS_AUTH=1

# ------------------------------------------------------------------------------
# 3. Database Persistence URL
# ------------------------------------------------------------------------------
# The connection string for the analytics and metadata database.
#
# Defaults to a local SQLite file in the backend directory if not specified.
# For production deployments, a managed PostgreSQL instance is recommended.
#
# SQLite default:
ANALYTICS_DB_URL=sqlite:///./backend/analytics.sqlite3
#
# PostgreSQL example:
# ANALYTICS_DB_URL=postgresql://db_user:db_password@localhost:5432/walkies_db

# ------------------------------------------------------------------------------
# 4. Optional Tooling Configuration
# ------------------------------------------------------------------------------
# Required ONLY if you wish to run the LLM-enriched research sources digest tool
# to summarize clinical literature (`task sources:digest:llm`).
#
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
